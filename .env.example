# ==============================================================
# DOC-HUB UBB - PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================
# Copia este archivo a ".env" y personaliza tus credenciales:
#   cp .env.example .env
# NUNCA subas el archivo ".env" real al repositorio.
# ==============================================================

# --------------------------------------------------------------
# 1. Base de Datos MySQL
# --------------------------------------------------------------
DB_HOST=db
DB_PORT=3306
DB_NAME=ubb_doc_hub
DB_USER=root
DB_PASSWORD=password123

# --------------------------------------------------------------
# 2. Servidor Backend & Frontend (Despliegue y Red)
# --------------------------------------------------------------
# Puerto público que expondrá el Frontend/Nginx (el único puerto que se solicita a la universidad)
# Ejemplos: 8009, 80 (HTTP estándar), 8080 o el puerto asignado para tu usuario/servicio
APP_PORT=8009

# SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod
# Añade el dominio o IP pública del servidor aquí (ej: http://200.68.x.x:8009,http://dochub.ubiobio.cl)
CORS_ALLOWED_ORIGINS=http://localhost:8009,http://localhost:5173,http://localhost:80,http://localhost

# --------------------------------------------------------------
# 3. Inteligencia Artificial: RetroPlani Mate V3
# --------------------------------------------------------------
# Inferencia Cloud con Groq (Recomendado):
# Obtén tu clave gratuita en: https://console.groq.com
AI_LLM_BASE_URL=https://api.groq.com/openai/v1
AI_LLM_API_KEY=INSERTAR_API_KEY_PROPIA_AQUI
AI_LLM_MODEL=openai/gpt-oss-20b
AI_LLM_TIMEOUT_SECONDS=60

# Para inferencia 100% local con Ollama (si se dispone de GPU local):
# AI_LLM_BASE_URL=http://localhost:11434/v1
# AI_LLM_API_KEY=
# AI_LLM_MODEL=qwen2.5:7b-instruct-q4_K_M
